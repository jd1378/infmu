{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "tasks": {
    "dev": "deno run --allow-read=. --allow-write=dist --allow-run=deno --allow-net=127.0.0.1 --allow-env=PORT scripts/dev.ts",
    "build": "deno run --allow-read=. --allow-write=dist --allow-run=deno scripts/build.ts",
    "check": "deno check src scripts tests && deno lint && deno fmt --check",
    "render": "deno run --allow-read=. --allow-write=out scripts/render.ts",
    "test": "deno test --allow-read=."
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "exclude": [
      "dist",
      "out"
    ]
  },
  "lint": {
    "exclude": [
      "dist",
      "out"
    ]
  },
  "exclude": [
    "dist",
    "out"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/http": "jsr:@std/http@^1.1.3"
  },
  "lock": {
    "path": "deno.lock",
    "frozen": true
  }
}
